{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "es2023",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "module": "commonjs",
    "types": ["jest", "jest-expect-message"],
    "sourceMap": true,
    "skipLibCheck": true,// This tells TypeScript to skip type checking of all declaration files (*.d.ts).
  },
  "include": ["src", "src/__tests__"],
  "exclude": ["node_modules"],
}
