{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true, // still needed for some packages that don't have ESM support
    "isolatedModules": true,
    "strict": true,
    "module": "NodeNext",
    "types": ["jest", "jest-expect-message"],
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,// This tells TypeScript to skip type checking of all declaration files (*.d.ts).
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"],
}
